      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --slate-50: #F5F5F5;\n    --white: #FFFFFF;\n    --charcoal: #333333;\n    --soft-gray: #E5E5E5;\n    --prof-blue: #0D99FF;\n    --alert-red: #F24822;\n    --text-secondary: #888888;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    color: var(--charcoal);\n    background-color: var(--white);\n    margin: 0;\n    overflow: hidden;\n  }\n\n  .dot-grid {\n    background-image: radial-gradient(var(--soft-gray) 1px, transparent 0);\n    background-size: 20px 20px;\n    background-position: -10px -10px;\n  }\n\n  .inspector-label {\n    font-size: 11px;\n    color: var(--text-secondary);\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  .inspector-input {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 11px;\n    border: 1px solid transparent;\n    border-radius: 2px;\n    padding: 2px 4px;\n    width: 100%;\n    transition: all 0.1s ease;\n  }\n\n  .inspector-input:focus {\n    outline: none;\n    border-color: var(--prof-blue);\n    background-color: var(--white);\n  }\n\n  .inspector-input:hover:not(:focus) {\n    border-color: var(--soft-gray);\n  }\n\n  .toolbar-btn {\n    height: 32px;\n    width: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 4px;\n    transition: background 0.1s;\n    color: var(--charcoal);\n  }\n\n  .toolbar-btn:hover {\n    background-color: var(--slate-50);\n  }\n\n  .toolbar-btn.active {\n    color: var(--prof-blue);\n    background-color: rgba(13, 153, 255, 0.1);\n  }\n\n  ::-webkit-scrollbar {\n    width: 6px;\n    height: 6px;\n  }\n\n  ::-webkit-scrollbar-thumb {\n    background: var(--soft-gray);\n    border-radius: 3px;\n  }\n</style>\n\n<div class=\"h-screen flex flex-col bg-white\" data-kid=\"1\">\n  \n  <header class=\"h-[40px] border-b border-[#E5E5E5] flex items-center justify-between px-3 flex-shrink-0 z-30 bg-white\" data-kid=\"2\">\n    <div class=\"flex items-center gap-1\" data-kid=\"3\">\n      <div class=\"toolbar-btn\" data-kid=\"4\">\n        <i class=\"ti ti-menu-2 text-lg\" data-kid=\"5\"></i>\n      </div>\n      <div class=\"h-4 w-[1px] bg-[#E5E5E5] mx-1\" data-kid=\"6\"></div>\n      <div class=\"toolbar-btn active\" data-kid=\"7\">\n        <i class=\"ti ti-mouse-pointer text-lg\" data-kid=\"8\"></i>\n      </div>\n      <div class=\"toolbar-btn\" data-kid=\"9\">\n        <i class=\"ti ti-square text-lg\" data-kid=\"10\"></i>\n      </div>\n      <div class=\"toolbar-btn\" data-kid=\"11\">\n        <i class=\"ti ti-type text-lg\" data-kid=\"12\"></i>\n      </div>\n      <div class=\"toolbar-btn\" data-kid=\"13\">\n        <i class=\"ti ti-image text-lg\" data-kid=\"14\"></i>\n      </div>\n      <div class=\"toolbar-btn\" data-kid=\"15\">\n        <i class=\"ti ti-hand-stop text-lg\" data-kid=\"16\"></i>\n      </div>\n    </div>\n\n    <div class=\"absolute left-1/2 -translate-x-1/2 flex items-center gap-2\" data-kid=\"17\">\n      <span class=\"text-xs font-semibold\" data-kid=\"18\">Craft UI / Dashboard Design</span>\n      <i class=\"ti ti-chevron-down text-[10px] text-gray-400\" data-kid=\"19\"></i>\n    </div>\n\n    <div class=\"flex items-center gap-3\" data-kid=\"20\">\n      <div class=\"flex items-center gap-1\" data-kid=\"21\">\n        <span class=\"text-[11px] font-medium text-gray-500\" data-kid=\"22\">100%</span>\n        <i class=\"ti ti-chevron-down text-[10px] text-gray-400\" data-kid=\"23\"></i>\n      </div>\n      <button class=\"bg-[#0D99FF] hover:bg-[#0085FF] text-white text-[11px] font-semibold px-3 py-1.5 rounded transition-colors flex items-center gap-2\" data-kid=\"24\">\n        <span data-kid=\"25\">Share</span>\n      </button>\n      <div class=\"w-7 h-7 bg-gray-200 rounded-full flex items-center justify-center text-[10px] font-bold text-gray-600 border border-white shadow-sm overflow-hidden\" data-kid=\"26\">\n        <img src=\"https://i.pravatar.cc/100?u=editor\" class=\"w-full h-full object-cover\" loading=\"lazy\" decoding=\"async\" data-kid=\"27\">\n      </div>\n    </div>\n  </header>\n\n  \n  <main class=\"flex-1 flex min-h-0 relative\" data-kid=\"28\">\n    \n    <aside class=\"w-[240px] border-r border-[#E5E5E5] flex flex-col bg-white z-20\" data-kid=\"29\">\n      <div class=\"flex border-b border-[#E5E5E5]\" data-kid=\"30\">\n        <button class=\"flex-1 py-2 text-[11px] font-semibold border-b-2 border-[#0D99FF]\" data-kid=\"31\">Layers</button>\n        <button class=\"flex-1 py-2 text-[11px] font-semibold text-gray-400\" data-kid=\"32\">Assets</button>\n        <button class=\"flex-1 py-2 text-[11px] font-semibold text-gray-400\" data-kid=\"33\">Pages</button>\n      </div>\n      \n      <div class=\"flex-1 overflow-y-auto\" data-kid=\"34\">\n        \n        <div class=\"border-b border-[#F5F5F5]\" data-kid=\"35\">\n          <div class=\"px-3 py-2 flex items-center justify-between hover:bg-[#F5F5F5] cursor-pointer group\" data-kid=\"36\">\n            <div class=\"flex items-center gap-2\" data-kid=\"37\">\n              <i class=\"ti ti-chevron-down text-[10px] text-gray-400\" data-kid=\"38\"></i>\n              <span class=\"text-[11px] font-bold uppercase tracking-wider text-gray-500\" data-kid=\"39\">Components</span>\n            </div>\n            <i class=\"ti ti-plus text-[10px] text-gray-400 opacity-0 group-hover:opacity-100\" data-kid=\"40\"></i>\n          </div>\n          <div class=\"pb-2\" data-kid=\"41\">\n            <div class=\"px-6 py-1.5 flex items-center gap-2 hover:bg-[#F5F5F5] cursor-pointer\" data-kid=\"42\">\n              <div class=\"w-6 h-6 bg-gray-50 border border-[#E5E5E5] rounded flex items-center justify-center\" data-kid=\"43\">\n                <i class=\"ti ti-square-rounded text-blue-500 text-sm\" data-kid=\"44\"></i>\n              </div>\n              <span class=\"text-[11px]\" data-kid=\"45\">Primary Button</span>\n            </div>\n            <div class=\"px-6 py-1.5 flex items-center gap-2 hover:bg-[#F5F5F5] cursor-pointer\" data-kid=\"46\">\n              <div class=\"w-6 h-6 bg-gray-50 border border-[#E5E5E5] rounded flex items-center justify-center\" data-kid=\"47\">\n                <i class=\"ti ti-credit-card text-purple-500 text-sm\" data-kid=\"48\"></i>\n              </div>\n              <span class=\"text-[11px]\" data-kid=\"49\">Pricing Card</span>\n            </div>\n            <div class=\"px-6 py-1.5 flex items-center gap-2 hover:bg-[#F5F5F5] cursor-pointer\" data-kid=\"50\">\n              <div class=\"w-6 h-6 bg-gray-50 border border-[#E5E5E5] rounded flex items-center justify-center\" data-kid=\"51\">\n                <i class=\"ti ti-input-search text-green-500 text-sm\" data-kid=\"52\"></i>\n              </div>\n              <span class=\"text-[11px]\" data-kid=\"53\">Text Input</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"border-b border-[#F5F5F5]\" data-kid=\"54\">\n          <div class=\"px-3 py-2 flex items-center justify-between hover:bg-[#F5F5F5] cursor-pointer\" data-kid=\"55\">\n            <div class=\"flex items-center gap-2\" data-kid=\"56\">\n              <i class=\"ti ti-chevron-down text-[10px] text-gray-400\" data-kid=\"57\"></i>\n              <span class=\"text-[11px] font-bold uppercase tracking-wider text-gray-500\" data-kid=\"58\">Selection</span>\n            </div>\n          </div>\n          <div class=\"pb-2\" data-kid=\"59\">\n            <div class=\"px-6 py-1 flex items-center gap-2 bg-[#0D99FF]/5 border-l-2 border-[#0D99FF] cursor-pointer\" data-kid=\"60\">\n              <i class=\"ti ti-box text-[12px] text-blue-500\" data-kid=\"61\"></i>\n              <span class=\"text-[11px] font-medium py-1.5\" data-kid=\"62\">Hero Section</span>\n            </div>\n            <div class=\"px-10 py-1 flex items-center gap-2 hover:bg-[#F5F5F5] cursor-pointer\" data-kid=\"63\">\n              <i class=\"ti ti-type text-[12px] text-gray-400\" data-kid=\"64\"></i>\n              <span class=\"text-[11px] text-gray-600\" data-kid=\"65\">Main Title</span>\n            </div>\n            <div class=\"px-10 py-1 flex items-center gap-2 hover:bg-[#F5F5F5] cursor-pointer\" data-kid=\"66\">\n              <i class=\"ti ti-square text-[12px] text-gray-400\" data-kid=\"67\"></i>\n              <span class=\"text-[11px] text-gray-600\" data-kid=\"68\">CTA Button</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </aside>\n\n    \n    <section class=\"flex-1 bg-[#F5F5F5] relative overflow-hidden dot-grid\" data-kid=\"69\">\n      <div class=\"absolute inset-0 flex items-center justify-center p-20 overflow-auto\" data-kid=\"70\">\n        \n        <div class=\"bg-white w-[800px] min-h-[1000px] shadow-[0_2px_10px_rgba(0,0,0,0.05)] border border-[#E5E5E5] relative\" data-kid=\"71\">\n          \n          <div class=\"absolute top-[120px] left-[100px] w-[600px] h-[300px] border border-[#0D99FF] z-10\" data-kid=\"72\">\n            <div class=\"absolute -top-[20px] left-0 bg-[#0D99FF] text-white text-[9px] px-1.5 py-0.5 rounded-t font-semibold\" data-kid=\"73\">Hero Section</div>\n            <div class=\"absolute -top-1 -left-1 w-2 h-2 bg-white border border-[#0D99FF] rounded-full\" data-kid=\"74\"></div>\n            <div class=\"absolute -top-1 -right-1 w-2 h-2 bg-white border border-[#0D99FF] rounded-full\" data-kid=\"75\"></div>\n            <div class=\"absolute -bottom-1 -left-1 w-2 h-2 bg-white border border-[#0D99FF] rounded-full\" data-kid=\"76\"></div>\n            <div class=\"absolute -bottom-1 -right-1 w-2 h-2 bg-white border border-[#0D99FF] rounded-full\" data-kid=\"77\"></div>\n          </div>\n\n          \n          <div class=\"p-20 flex flex-col items-center text-center gap-6\" data-kid=\"78\">\n            <div class=\"w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mb-4\" data-kid=\"79\">\n              <i class=\"ti ti-rocket text-3xl text-blue-500\" data-kid=\"80\"></i>\n            </div>\n            <h1 class=\"text-4xl font-bold tracking-tight text-gray-900\" data-kid=\"81\">Build faster with Craft UI</h1>\n            <p class=\"text-lg text-gray-500 max-w-md\" data-kid=\"82\">The ultimate visual editor for modern design systems. Drag, drop, and export production-ready code.</p>\n            <div class=\"flex gap-4 mt-4\" data-kid=\"83\">\n              <div class=\"px-8 py-3 bg-gray-900 text-white font-semibold rounded-lg shadow-lg\" data-kid=\"84\">Get Started</div>\n              <div class=\"px-8 py-3 border border-gray-200 font-semibold rounded-lg\" data-kid=\"85\">View Components</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 bg-white border border-[#E5E5E5] shadow-xl p-1 rounded-lg\" data-kid=\"86\">\n        <div class=\"toolbar-btn\" data-kid=\"87\"><i class=\"ti ti-zoom-out\" data-kid=\"88\"></i></div>\n        <div class=\"h-4 w-[1px] bg-gray-200\" data-kid=\"89\"></div>\n        <span class=\"text-[11px] font-bold px-2\" data-kid=\"90\">100%</span>\n        <div class=\"h-4 w-[1px] bg-gray-200\" data-kid=\"91\"></div>\n        <div class=\"toolbar-btn\" data-kid=\"92\"><i class=\"ti ti-zoom-in\" data-kid=\"93\"></i></div>\n      </div>\n    </section>\n\n    \n    <aside class=\"w-[280px] border-l border-[#E5E5E5] flex flex-col bg-white z-20\" data-kid=\"94\">\n      <div class=\"flex border-b border-[#E5E5E5]\" data-kid=\"95\">\n        <button class=\"flex-1 py-2 text-[11px] font-semibold border-b-2 border-[#0D99FF]\" data-kid=\"96\">Design</button>\n        <button class=\"flex-1 py-2 text-[11px] font-semibold text-gray-400\" data-kid=\"97\">Prototype</button>\n        <button class=\"flex-1 py-2 text-[11px] font-semibold text-gray-400\" data-kid=\"98\">Inspect</button>\n      </div>\n\n      <div class=\"flex-1 overflow-y-auto\" data-kid=\"99\">\n        \n        <div class=\"p-3 border-b border-[#F5F5F5]\" data-kid=\"100\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"101\">\n            <span class=\"text-[11px] font-bold uppercase tracking-wider text-gray-500\" data-kid=\"102\">Layout</span>\n            <i class=\"ti ti-dots text-gray-400\" data-kid=\"103\"></i>\n          </div>\n          \n          <div class=\"grid grid-cols-2 gap-x-4 gap-y-3\" data-kid=\"104\">\n            <div class=\"flex flex-col gap-1\" data-kid=\"105\">\n              <span class=\"inspector-label\" data-kid=\"106\">Width</span>\n              <div class=\"relative flex items-center\" data-kid=\"107\">\n                <i class=\"ti ti-arrows-horizontal absolute left-2 text-[10px] text-gray-400\" data-kid=\"108\"></i>\n                <input type=\"text\" value=\"600\" class=\"inspector-input bg-gray-50 pl-6\" data-kid=\"109\">\n              </div>\n            </div>\n            <div class=\"flex flex-col gap-1\" data-kid=\"110\">\n              <span class=\"inspector-label\" data-kid=\"111\">Height</span>\n              <div class=\"relative flex items-center\" data-kid=\"112\">\n                <i class=\"ti ti-arrows-vertical absolute left-2 text-[10px] text-gray-400\" data-kid=\"113\"></i>\n                <input type=\"text\" value=\"300\" class=\"inspector-input bg-gray-50 pl-6\" data-kid=\"114\">\n              </div>\n            </div>\n            <div class=\"flex flex-col gap-1\" data-kid=\"115\">\n              <span class=\"inspector-label\" data-kid=\"116\">X</span>\n              <input type=\"text\" value=\"100\" class=\"inspector-input bg-gray-50\" data-kid=\"117\">\n            </div>\n            <div class=\"flex flex-col gap-1\" data-kid=\"118\">\n              <span class=\"inspector-label\" data-kid=\"119\">Y</span>\n              <input type=\"text\" value=\"120\" class=\"inspector-input bg-gray-50\" data-kid=\"120\">\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"p-3 border-b border-[#F5F5F5]\" data-kid=\"121\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"122\">\n            <span class=\"text-[11px] font-bold uppercase tracking-wider text-gray-500\" data-kid=\"123\">Fill</span>\n            <i class=\"ti ti-plus text-gray-400\" data-kid=\"124\"></i>\n          </div>\n          <div class=\"flex items-center justify-between\" data-kid=\"125\">\n            <div class=\"flex items-center gap-2\" data-kid=\"126\">\n              <div class=\"w-4 h-4 rounded border border-gray-200\" style=\"background-color: #FFFFFF;\" data-kid=\"127\"></div>\n              <span class=\"inspector-input uppercase\" data-kid=\"128\">FFFFFF</span>\n            </div>\n            <span class=\"text-[11px] text-gray-400\" data-kid=\"129\">100%</span>\n          </div>\n        </div>\n\n        \n        <div class=\"p-3 border-b border-[#F5F5F5]\" data-kid=\"130\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"131\">\n            <span class=\"text-[11px] font-bold uppercase tracking-wider text-gray-500\" data-kid=\"132\">Stroke</span>\n            <i class=\"ti ti-plus text-gray-400\" data-kid=\"133\"></i>\n          </div>\n          <div class=\"flex items-center justify-between\" data-kid=\"134\">\n            <div class=\"flex items-center gap-2\" data-kid=\"135\">\n              <div class=\"w-4 h-4 rounded border border-gray-200\" style=\"background-color: #0D99FF;\" data-kid=\"136\"></div>\n              <span class=\"inspector-input uppercase\" data-kid=\"137\">0D99FF</span>\n            </div>\n            <span class=\"text-[11px] text-gray-400\" data-kid=\"138\">1px</span>\n          </div>\n        </div>\n\n        \n        <div class=\"p-3\" data-kid=\"139\">\n          <div class=\"flex items-center justify-between mb-2\" data-kid=\"140\">\n            <span class=\"text-[11px] font-bold uppercase tracking-wider text-gray-500\" data-kid=\"141\">Effects</span>\n            <i class=\"ti ti-plus text-gray-400\" data-kid=\"142\"></i>\n          </div>\n          <div class=\"flex items-center gap-2 py-1\" data-kid=\"143\">\n            <i class=\"ti ti-inner-shadow-bottom text-gray-400\" data-kid=\"144\"></i>\n            <span class=\"text-[11px] text-gray-600\" data-kid=\"145\">Drop Shadow</span>\n          </div>\n        </div>\n      </div>\n    </aside>\n  </main>\n\n  \n  <footer class=\"h-[24px] bg-white border-t border-[#E5E5E5] flex items-center justify-between px-3 z-30 flex-shrink-0\" data-kid=\"146\">\n    <div class=\"flex items-center gap-4 text-[10px] font-medium text-gray-400\" data-kid=\"147\">\n      <div class=\"flex items-center gap-1.5\" data-kid=\"148\">\n        <i class=\"ti ti-cursor-text\" data-kid=\"149\"></i>\n        <span data-kid=\"150\">X: 0 | Y: 0</span>\n      </div>\n      <div class=\"flex items-center gap-1.5\" data-kid=\"151\">\n        <i class=\"ti ti-grid-dots\" data-kid=\"152\"></i>\n        <span data-kid=\"153\">Grid: 20px</span>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-3 text-[10px] font-medium text-gray-400\" data-kid=\"154\">\n      <div class=\"flex items-center gap-1\" data-kid=\"155\">\n        <div class=\"w-2 h-2 bg-green-500 rounded-full animate-pulse\" data-kid=\"156\"></div>\n        <span data-kid=\"157\">Ready</span>\n      </div>\n      <span data-kid=\"158\">v1.0.2</span>\n    </div>\n  </footer>\n</div>",
