      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    font-family: 'Space Grotesk', sans-serif;\n    background-color: #f5f0eb;\n    color: #000;\n  }\n\n  .mono {\n    font-family: 'IBM Plex Mono', monospace;\n  }\n\n  .brutal-border {\n    border: 2px solid #000;\n  }\n\n  .brutal-shadow {\n    box-shadow: 3px 3px 0 0 #000;\n  }\n\n  .brutal-shadow-lg {\n    box-shadow: 6px 6px 0 0 #000;\n  }\n\n  .brutal-btn-primary {\n    background-color: #fbbf24;\n    transition: all 0.1s ease;\n  }\n\n  .brutal-btn-primary:hover {\n    transform: translate(-2px, -2px);\n    box-shadow: 5px 5px 0 0 #000;\n  }\n\n  .brutal-btn-primary:active {\n    transform: translate(2px, 2px);\n    box-shadow: none;\n  }\n\n  .brutal-btn-ghost {\n    background-color: #fff;\n    transition: all 0.1s ease;\n  }\n\n  .brutal-btn-ghost:hover {\n    background-color: #fbbf24;\n    transform: translate(-1px, -1px);\n    box-shadow: 2px 2px 0 0 #000;\n  }\n\n  .dot-grid {\n    background-image: radial-gradient(#000 1.5px, transparent 1.5px);\n    background-size: 40px 40px;\n  }\n\n  .scrollbar-hide::-webkit-scrollbar {\n    display: none;\n  }\n</style>\n\n<div class=\"h-screen flex flex-col overflow-hidden selection:bg-[#3b82f6] selection:text-white\" data-kid=\"1\">\n  \n  <header class=\"h-16 bg-white border-b-2 border-black flex items-center justify-between px-6 z-50\" data-kid=\"2\">\n    <div class=\"flex items-center gap-8\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-black flex items-center justify-center border-2 border-black shadow-[3px_3px_0_0_#fbbf24]\" data-kid=\"5\">\n          <i class=\"ti ti-box text-white text-xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-xl font-bold uppercase tracking-tight\" data-kid=\"7\">Craft UI <span class=\"text-[#ef4444]\" data-kid=\"8\">Pro</span></span>\n      </div>\n      \n      <nav class=\"hidden md:flex items-center gap-1 border-2 border-black bg-[#f5f0eb] p-1\" data-kid=\"9\">\n        <button class=\"px-3 py-1.5 font-bold hover:bg-black hover:text-white transition-colors\" data-kid=\"10\">Project</button>\n        <button class=\"px-3 py-1.5 font-bold bg-black text-white\" data-kid=\"11\">Editor</button>\n        <button class=\"px-3 py-1.5 font-bold hover:bg-black hover:text-white transition-colors\" data-kid=\"12\">Assets</button>\n      </nav>\n    </div>\n\n    <div class=\"flex items-center gap-4\" data-kid=\"13\">\n      <div class=\"flex items-center gap-2 border-r-2 border-black pr-4 mr-2\" data-kid=\"14\">\n        <button class=\"p-2 hover:bg-[#fbbf24] border-2 border-transparent hover:border-black transition-all\" data-kid=\"15\">\n          <i class=\"ti ti-rotate-2 text-xl\" data-kid=\"16\"></i>\n        </button>\n        <button class=\"p-2 hover:bg-[#fbbf24] border-2 border-transparent hover:border-black transition-all\" data-kid=\"17\">\n          <i class=\"ti ti-rotate-clockwise-2 text-xl\" data-kid=\"18\"></i>\n        </button>\n      </div>\n      \n      <div class=\"flex items-center gap-3\" data-kid=\"19\">\n        <button class=\"brutal-btn-ghost border-2 border-black px-4 py-2 font-bold brutal-shadow flex items-center gap-2\" data-kid=\"20\">\n          <i class=\"ti ti-device-floppy text-lg\" data-kid=\"21\"></i>\n          SAVE\n        </button>\n        <button class=\"brutal-btn-primary border-2 border-black px-6 py-2 font-bold brutal-shadow flex items-center gap-2\" data-kid=\"22\">\n          <i class=\"ti ti-play-circle text-lg\" data-kid=\"23\"></i>\n          EXPORT\n        </button>\n      </div>\n    </div>\n  </header>\n\n  \n  <main class=\"flex-1 flex overflow-hidden\" data-kid=\"24\">\n    \n    <aside class=\"w-72 bg-white border-r-2 border-black flex flex-col z-40\" data-kid=\"25\">\n      <div class=\"p-4 border-b-2 border-black bg-[#f5f0eb]\" data-kid=\"26\">\n        <div class=\"relative group\" data-kid=\"27\">\n          <input type=\"text\" placeholder=\"SEARCH COMPONENTS...\" class=\"w-full bg-white border-2 border-black px-4 py-2 font-bold focus:shadow-[4px_4px_0_0_#000] outline-none transition-all\" data-kid=\"28\">\n          <i class=\"ti ti-search absolute right-3 top-1/2 -translate-y-1/2 text-xl\" data-kid=\"29\"></i>\n        </div>\n      </div>\n      \n      <div class=\"flex-1 overflow-y-auto p-4 space-y-6 scrollbar-hide\" data-kid=\"30\">\n        <section data-kid=\"31\">\n          <h3 class=\"text-xs font-black uppercase tracking-widest text-[#6b7280] mb-4 flex items-center justify-between\" data-kid=\"32\">\n            Basic Elements\n            <i class=\"ti ti-chevron-down\" data-kid=\"33\"></i>\n          </h3>\n          <div class=\"grid grid-cols-2 gap-3\" data-kid=\"34\">\n            <div class=\"bg-white border-2 border-black p-3 flex flex-col items-center justify-center gap-2 hover:bg-[#3b82f6] hover:text-white cursor-pointer transition-colors group\" data-kid=\"35\">\n              <i class=\"ti ti-square text-2xl group-hover:scale-110 transition-transform\" data-kid=\"36\"></i>\n              <span class=\"text-[10px] font-bold uppercase\" data-kid=\"37\">Section</span>\n            </div>\n            <div class=\"bg-[#fbbf24] border-2 border-black p-3 flex flex-col items-center justify-center gap-2 cursor-pointer brutal-shadow-sm hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all\" data-kid=\"38\">\n              <i class=\"ti ti-typography text-2xl\" data-kid=\"39\"></i>\n              <span class=\"text-[10px] font-bold uppercase\" data-kid=\"40\">Text Block</span>\n            </div>\n            <div class=\"bg-white border-2 border-black p-3 flex flex-col items-center justify-center gap-2 hover:bg-[#ef4444] hover:text-white cursor-pointer transition-colors group\" data-kid=\"41\">\n              <i class=\"ti ti-button text-2xl group-hover:scale-110 transition-transform\" data-kid=\"42\"></i>\n              <span class=\"text-[10px] font-bold uppercase\" data-kid=\"43\">Button</span>\n            </div>\n            <div class=\"bg-white border-2 border-black p-3 flex flex-col items-center justify-center gap-2 hover:bg-[#fbbf24] cursor-pointer transition-colors group\" data-kid=\"44\">\n              <i class=\"ti ti-photo text-2xl group-hover:scale-110 transition-transform\" data-kid=\"45\"></i>\n              <span class=\"text-[10px] font-bold uppercase\" data-kid=\"46\">Image</span>\n            </div>\n          </div>\n        </section>\n\n        <section data-kid=\"47\">\n          <h3 class=\"text-xs font-black uppercase tracking-widest text-[#6b7280] mb-4\" data-kid=\"48\">Form Controls</h3>\n          <div class=\"space-y-3\" data-kid=\"49\">\n            <div class=\"bg-white border-2 border-black p-3 flex items-center gap-4 hover:border-[#3b82f6] cursor-pointer group\" data-kid=\"50\">\n              <div class=\"w-8 h-8 border-2 border-black flex items-center justify-center bg-[#f5f0eb] group-hover:bg-[#3b82f6] group-hover:text-white transition-colors\" data-kid=\"51\">\n                <i class=\"ti ti-input-search\" data-kid=\"52\"></i>\n              </div>\n              <span class=\"text-xs font-bold uppercase\" data-kid=\"53\">Input Field</span>\n            </div>\n            <div class=\"bg-white border-2 border-black p-3 flex items-center gap-4 hover:border-[#ef4444] cursor-pointer group\" data-kid=\"54\">\n              <div class=\"w-8 h-8 border-2 border-black flex items-center justify-center bg-[#f5f0eb] group-hover:bg-[#ef4444] group-hover:text-white transition-colors\" data-kid=\"55\">\n                <i class=\"ti ti-checkbox\" data-kid=\"56\"></i>\n              </div>\n              <span class=\"text-xs font-bold uppercase\" data-kid=\"57\">Checkbox</span>\n            </div>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"p-4 bg-black text-white mt-auto flex items-center justify-between\" data-kid=\"58\">\n        <div class=\"flex items-center gap-2\" data-kid=\"59\">\n          <i class=\"ti ti-help-circle text-lg\" data-kid=\"60\"></i>\n          <span class=\"text-xs font-bold uppercase tracking-wider\" data-kid=\"61\">DOCS</span>\n        </div>\n        <i class=\"ti ti-external-link text-lg\" data-kid=\"62\"></i>\n      </div>\n    </aside>\n\n    \n    <section class=\"flex-1 bg-[#d1d5db] relative overflow-auto p-12 dot-grid flex items-start justify-center\" data-kid=\"63\">\n      \n      <div class=\"absolute top-10 left-10 opacity-10 pointer-events-none\" data-kid=\"64\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/burst-blob.svg\" class=\"w-48 h-48\" style=\"filter: invert(1);\" data-kid=\"65\">\n      </div>\n      <div class=\"absolute bottom-10 right-10 opacity-10 pointer-events-none\" data-kid=\"66\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/explosion-rays.svg\" class=\"w-64 h-64\" style=\"filter: invert(1);\" data-kid=\"67\">\n      </div>\n\n      \n      <div class=\"bg-white border-[3px] border-black w-[800px] min-h-[1000px] shadow-[12px_12px_0_0_#000] relative p-12 overflow-hidden\" data-kid=\"68\">\n        \n        <div class=\"border-b-2 border-black pb-8 mb-12\" data-kid=\"69\">\n          <div class=\"inline-block bg-[#fbbf24] border-2 border-black px-3 py-1 text-xs font-black uppercase mb-4\" data-kid=\"70\">Hero Section</div>\n          <h1 class=\"text-6xl font-black leading-none mb-6\" data-kid=\"71\">REDEFINE THE <span class=\"bg-[#3b82f6] text-white px-2\" data-kid=\"72\">VISUAL</span> WORKFLOW.</h1>\n          <p class=\"text-xl font-medium max-w-lg mb-8 leading-relaxed\" data-kid=\"73\">A discipline of structure and chaos. Built for those who demand precision in every pixel and bold strokes in every line.</p>\n          <div class=\"flex gap-4\" data-kid=\"74\">\n            <button class=\"bg-[#ef4444] text-white border-2 border-black px-8 py-3 font-bold brutal-shadow\" data-kid=\"75\">GET STARTED</button>\n            <button class=\"bg-white border-2 border-black px-8 py-3 font-bold brutal-shadow\" data-kid=\"76\">LEARN MORE</button>\n          </div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-8\" data-kid=\"77\">\n          <div class=\"border-2 border-black p-6 bg-[#f5f0eb] shadow-[6px_6px_0_0_#000]\" data-kid=\"78\">\n            <i class=\"ti ti-layout-grid text-4xl mb-4 text-[#3b82f6]\" data-kid=\"79\"></i>\n            <h3 class=\"text-xl font-bold mb-2\" data-kid=\"80\">GRID SYSTEM</h3>\n            <p class=\"text-sm\" data-kid=\"81\">Strict alignment rules enforced at the core level.</p>\n          </div>\n          <div class=\"border-2 border-black p-6 bg-white shadow-[6px_6px_0_0_#000]\" data-kid=\"82\">\n            <i class=\"ti ti-palette text-4xl mb-4 text-[#fbbf24]\" data-kid=\"83\"></i>\n            <h3 class=\"text-xl font-bold mb-2\" data-kid=\"84\">THEME ENGINE</h3>\n            <p class=\"text-sm\" data-kid=\"85\">Dynamic color mapping with instant preview.</p>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute top-[480px] left-[40px] w-[350px] h-[180px] border-2 border-[#3b82f6] pointer-events-none ring-2 ring-[#3b82f6]/20\" data-kid=\"86\">\n          <div class=\"absolute -top-3 -left-3 w-6 h-6 bg-white border-2 border-[#3b82f6]\" data-kid=\"87\"></div>\n          <div class=\"absolute -top-3 -right-3 w-6 h-6 bg-white border-2 border-[#3b82f6]\" data-kid=\"88\"></div>\n          <div class=\"absolute -bottom-3 -left-3 w-6 h-6 bg-white border-2 border-[#3b82f6]\" data-kid=\"89\"></div>\n          <div class=\"absolute -bottom-3 -right-3 w-6 h-6 bg-white border-2 border-[#3b82f6]\" data-kid=\"90\"></div>\n          <div class=\"absolute -top-8 left-0 bg-[#3b82f6] text-white px-2 py-0.5 text-[10px] font-bold uppercase tracking-tighter\" data-kid=\"91\">Feature Card v1.2</div>\n        </div>\n      </div>\n    </section>\n\n    \n    <aside class=\"w-80 bg-white border-l-2 border-black flex flex-col z-40\" data-kid=\"92\">\n      <div class=\"flex border-b-2 border-black\" data-kid=\"93\">\n        <button class=\"flex-1 py-3 text-xs font-black uppercase tracking-widest bg-black text-white\" data-kid=\"94\">Styles</button>\n        <button class=\"flex-1 py-3 text-xs font-black uppercase tracking-widest hover:bg-[#f5f0eb] border-l-2 border-black\" data-kid=\"95\">Config</button>\n        <button class=\"flex-1 py-3 text-xs font-black uppercase tracking-widest hover:bg-[#f5f0eb] border-l-2 border-black\" data-kid=\"96\">Data</button>\n      </div>\n\n      <div class=\"flex-1 overflow-y-auto p-5 space-y-8 scrollbar-hide\" data-kid=\"97\">\n        \n        <section data-kid=\"98\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"99\">\n            <h3 class=\"text-sm font-black uppercase tracking-tighter\" data-kid=\"100\">Layout Settings</h3>\n            <i class=\"ti ti-chevron-down-right text-xl\" data-kid=\"101\"></i>\n          </div>\n          \n          <div class=\"space-y-4\" data-kid=\"102\">\n            <div class=\"grid grid-cols-2 gap-3\" data-kid=\"103\">\n              <div class=\"space-y-1\" data-kid=\"104\">\n                <label class=\"text-[10px] font-black uppercase text-[#6b7280]\" data-kid=\"105\">Width</label>\n                <div class=\"relative\" data-kid=\"106\">\n                  <input type=\"text\" value=\"350px\" class=\"w-full bg-white border-2 border-black px-2 py-1.5 text-xs font-bold outline-none focus:bg-[#f5f0eb]\" data-kid=\"107\">\n                  <span class=\"absolute right-2 top-1/2 -translate-y-1/2 text-[9px] font-bold\" data-kid=\"108\">PX</span>\n                </div>\n              </div>\n              <div class=\"space-y-1\" data-kid=\"109\">\n                <label class=\"text-[10px] font-black uppercase text-[#6b7280]\" data-kid=\"110\">Height</label>\n                <div class=\"relative\" data-kid=\"111\">\n                  <input type=\"text\" value=\"180px\" class=\"w-full bg-white border-2 border-black px-2 py-1.5 text-xs font-bold outline-none focus:bg-[#f5f0eb]\" data-kid=\"112\">\n                  <span class=\"absolute right-2 top-1/2 -translate-y-1/2 text-[9px] font-bold\" data-kid=\"113\">PX</span>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"space-y-1\" data-kid=\"114\">\n              <label class=\"text-[10px] font-black uppercase text-[#6b7280]\" data-kid=\"115\">Flex Direction</label>\n              <div class=\"grid grid-cols-4 border-2 border-black divide-x-2 divide-black\" data-kid=\"116\">\n                <button class=\"p-2 hover:bg-[#fbbf24] bg-[#fbbf24]\" data-kid=\"117\"><i class=\"ti ti-arrow-right\" data-kid=\"118\"></i></button>\n                <button class=\"p-2 hover:bg-[#fbbf24]\" data-kid=\"119\"><i class=\"ti ti-arrow-down\" data-kid=\"120\"></i></button>\n                <button class=\"p-2 hover:bg-[#fbbf24]\" data-kid=\"121\"><i class=\"ti ti-arrow-left\" data-kid=\"122\"></i></button>\n                <button class=\"p-2 hover:bg-[#fbbf24]\" data-kid=\"123\"><i class=\"ti ti-arrow-up\" data-kid=\"124\"></i></button>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        \n        <section data-kid=\"125\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"126\">\n            <h3 class=\"text-sm font-black uppercase tracking-tighter\" data-kid=\"127\">Typography</h3>\n            <i class=\"ti ti-chevron-down-right text-xl\" data-kid=\"128\"></i>\n          </div>\n          <div class=\"space-y-4\" data-kid=\"129\">\n            <div class=\"space-y-1\" data-kid=\"130\">\n              <label class=\"text-[10px] font-black uppercase text-[#6b7280]\" data-kid=\"131\">Font Family</label>\n              <select class=\"w-full bg-white border-2 border-black px-2 py-1.5 text-xs font-bold outline-none cursor-pointer\" data-kid=\"132\">\n                <option data-kid=\"133\">Space Grotesk</option>\n                <option data-kid=\"134\">Inter</option>\n                <option data-kid=\"135\">IBM Plex Mono</option>\n              </select>\n            </div>\n            <div class=\"grid grid-cols-2 gap-3\" data-kid=\"136\">\n              <div class=\"space-y-1\" data-kid=\"137\">\n                <label class=\"text-[10px] font-black uppercase text-[#6b7280]\" data-kid=\"138\">Size</label>\n                <input type=\"number\" value=\"20\" class=\"w-full bg-white border-2 border-black px-2 py-1.5 text-xs font-bold outline-none\" data-kid=\"139\">\n              </div>\n              <div class=\"space-y-1\" data-kid=\"140\">\n                <label class=\"text-[10px] font-black uppercase text-[#6b7280]\" data-kid=\"141\">Weight</label>\n                <select class=\"w-full bg-white border-2 border-black px-2 py-1.5 text-xs font-bold outline-none\" data-kid=\"142\">\n                  <option data-kid=\"143\">700 (Bold)</option>\n                  <option data-kid=\"144\">900 (Black)</option>\n                </select>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        \n        <section data-kid=\"145\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"146\">\n            <h3 class=\"text-sm font-black uppercase tracking-tighter\" data-kid=\"147\">Effects & Shadows</h3>\n            <i class=\"ti ti-chevron-down-right text-xl\" data-kid=\"148\"></i>\n          </div>\n          <div class=\"space-y-3\" data-kid=\"149\">\n            <div class=\"flex items-center justify-between bg-[#f5f0eb] border-2 border-black p-3 group hover:bg-[#fbbf24] transition-colors cursor-pointer\" data-kid=\"150\">\n              <span class=\"text-xs font-bold uppercase\" data-kid=\"151\">Brutal Shadow v1</span>\n              <i class=\"ti ti-circle-check-filled text-[#3b82f6]\" data-kid=\"152\"></i>\n            </div>\n            <div class=\"flex items-center justify-between border-2 border-black p-3 hover:bg-[#f5f0eb] transition-colors cursor-pointer\" data-kid=\"153\">\n              <span class=\"text-xs font-bold uppercase\" data-kid=\"154\">Soft Depth</span>\n              <i class=\"ti ti-circle text-[#d1d5db]\" data-kid=\"155\"></i>\n            </div>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"p-5 border-t-2 border-black bg-[#fbbf24]\" data-kid=\"156\">\n        <button class=\"w-full bg-black text-white border-2 border-black py-3 font-bold brutal-shadow flex items-center justify-center gap-2\" data-kid=\"157\">\n          <i class=\"ti ti-trash-x text-lg\" data-kid=\"158\"></i>\n          DELETE ELEMENT\n        </button>\n      </div>\n    </aside>\n  </main>\n\n  \n  <footer class=\"h-8 bg-black text-white flex items-center justify-between px-6 z-50\" data-kid=\"159\">\n    <div class=\"flex items-center gap-6 mono text-[10px] uppercase tracking-[0.2em]\" data-kid=\"160\">\n      <div class=\"flex items-center gap-2\" data-kid=\"161\">\n        <span class=\"text-[#fbbf24]\" data-kid=\"162\">X:</span>\n        <span class=\"w-12\" data-kid=\"163\">0420.22</span>\n      </div>\n      <div class=\"flex items-center gap-2\" data-kid=\"164\">\n        <span class=\"text-[#fbbf24]\" data-kid=\"165\">Y:</span>\n        <span class=\"w-12\" data-kid=\"166\">0100.84</span>\n      </div>\n      <div class=\"h-4 w-px bg-white/20\" data-kid=\"167\"></div>\n      <div class=\"flex items-center gap-2\" data-kid=\"168\">\n        <span class=\"text-[#3b82f6]\" data-kid=\"169\">ZOOM:</span>\n        <span data-kid=\"170\">100%</span>\n      </div>\n    </div>\n\n    <div class=\"flex items-center gap-4 mono text-[10px] uppercase tracking-widest font-medium\" data-kid=\"171\">\n      <span class=\"text-[#ef4444] animate-pulse\" data-kid=\"172\">● LIVE UPDATING</span>\n      <div class=\"h-4 w-px bg-white/20\" data-kid=\"173\"></div>\n      <span data-kid=\"174\">v2.4.1-STABLE</span>\n    </div>\n  </footer>\n</div>",
