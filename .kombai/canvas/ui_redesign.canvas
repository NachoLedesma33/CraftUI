      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    background-color: #0A0A0A;\n    color: #EDEDED;\n    margin: 0;\n    overflow: hidden;\n  }\n\n  .glass-panel {\n    background: rgba(20, 20, 20, 0.7);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .cyber-grid {\n    background-color: #050505;\n    background-image: \n      linear-gradient(to right, rgba(0, 229, 255, 0.05) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(0, 229, 255, 0.05) 1px, transparent 1px);\n    background-size: 40px 40px;\n    position: relative;\n  }\n\n  .cyber-grid::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at center, transparent 0%, rgba(5, 5, 5, 0.8) 100%);\n    pointer-events: none;\n  }\n\n  .neon-glow-cyan {\n    box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);\n  }\n\n  .neon-glow-magenta {\n    box-shadow: 0 0 15px rgba(255, 0, 255, 0.3);\n  }\n\n  .wireframe-card {\n    border: 1px solid rgba(0, 229, 255, 0.2);\n    background: rgba(0, 229, 255, 0.03);\n    transition: all 0.2s ease;\n  }\n\n  .wireframe-card:hover {\n    border-color: #00E5FF;\n    background: rgba(0, 229, 255, 0.08);\n    box-shadow: 0 0 10px rgba(0, 229, 255, 0.2);\n    transform: translateY(-1px);\n  }\n\n  .input-neon {\n    background: transparent;\n    border: none;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n    transition: all 0.2s ease;\n  }\n\n  .input-neon:focus {\n    outline: none;\n    border-color: #00E5FF;\n    box-shadow: 0 1px 0 0 #00E5FF;\n  }\n\n  .tab-active::after {\n    content: '';\n    position: absolute;\n    bottom: -1px;\n    left: 0;\n    right: 0;\n    height: 2px;\n    background: linear-gradient(to right, #00E5FF, #FF00FF);\n    box-shadow: 0 2px 8px rgba(0, 229, 255, 0.5);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 4px; }\n  ::-webkit-scrollbar-track { background: transparent; }\n  ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: rgba(0, 229, 255, 0.3); }\n\n  .monospace { font-family: 'JetBrains Mono', monospace; }\n</style>\n\n<div class=\"relative h-screen w-screen flex flex-col overflow-hidden\" data-kid=\"1\">\n  \n  \n  <div class=\"fixed top-6 left-1/2 -translate-x-1/2 z-50 flex items-center justify-center\" data-kid=\"2\">\n    <div class=\"glass-panel flex items-center gap-2 px-4 py-2 rounded-full shadow-2xl\" data-kid=\"3\">\n      \n      <div class=\"flex items-center gap-3 pr-4 border-r border-white/10 mr-2\" data-kid=\"4\">\n        <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-[#00E5FF] to-[#FF00FF] flex items-center justify-center neon-glow-cyan\" data-kid=\"5\">\n          <i class=\"ti ti-cpu text-[#0A0A0A] text-lg font-bold\" data-kid=\"6\"></i>\n        </div>\n        <div class=\"flex flex-col\" data-kid=\"7\">\n          <span class=\"text-xs font-bold tracking-wider uppercase\" data-kid=\"8\">Craft UI</span>\n          <span class=\"text-[10px] text-[#888888] font-medium\" data-kid=\"9\">v2.0.4 - beta</span>\n        </div>\n      </div>\n\n      \n      <div class=\"flex items-center gap-1 px-2\" data-kid=\"10\">\n        <button class=\"p-2 rounded-lg hover:bg-white/5 text-[#00E5FF] transition-all\" data-kid=\"11\">\n          <i class=\"ti ti-mouse-pointer text-xl\" data-kid=\"12\"></i>\n        </button>\n        <button class=\"p-2 rounded-lg hover:bg-white/5 text-[#888888] transition-all\" data-kid=\"13\">\n          <i class=\"ti ti-square text-xl\" data-kid=\"14\"></i>\n        </button>\n        <button class=\"p-2 rounded-lg hover:bg-white/5 text-[#888888] transition-all\" data-kid=\"15\">\n          <i class=\"ti ti-typography text-xl\" data-kid=\"16\"></i>\n        </button>\n        <button class=\"p-2 rounded-lg hover:bg-white/5 text-[#888888] transition-all\" data-kid=\"17\">\n          <i class=\"ti ti-image text-xl\" data-kid=\"18\"></i>\n        </button>\n      </div>\n\n      <div class=\"h-6 w-px bg-white/10 mx-1\" data-kid=\"19\"></div>\n\n      \n      <div class=\"flex items-center gap-1 px-2\" data-kid=\"20\">\n        <button class=\"flex items-center gap-2 px-3 py-1.5 rounded-lg hover:bg-white/5 text-[#888888] transition-all\" data-kid=\"21\">\n          <i class=\"ti ti-arrow-back-up text-lg\" data-kid=\"22\"></i>\n        </button>\n        <button class=\"flex items-center gap-2 px-3 py-1.5 rounded-lg hover:bg-white/5 text-[#888888] transition-all\" data-kid=\"23\">\n          <i class=\"ti ti-arrow-forward-up text-lg\" data-kid=\"24\"></i>\n        </button>\n      </div>\n\n      <div class=\"h-6 w-px bg-white/10 mx-1\" data-kid=\"25\"></div>\n\n      \n      <div class=\"flex items-center gap-2 pl-2\" data-kid=\"26\">\n        <div class=\"flex items-center gap-1 bg-white/5 rounded-lg px-2 py-1\" data-kid=\"27\">\n          <button class=\"p-1 hover:text-[#00E5FF] transition-colors\" data-kid=\"28\"><i class=\"ti ti-minus text-sm\" data-kid=\"29\"></i></button>\n          <span class=\"text-[10px] font-bold monospace w-10 text-center\" data-kid=\"30\">100%</span>\n          <button class=\"p-1 hover:text-[#00E5FF] transition-colors\" data-kid=\"31\"><i class=\"ti ti-plus text-sm\" data-kid=\"32\"></i></button>\n        </div>\n        <button class=\"bg-[#00E5FF] text-[#0A0A0A] font-bold text-xs px-4 py-1.5 rounded-full hover:brightness-110 transition-all neon-glow-cyan\" data-kid=\"33\">\n          EXPORT\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"flex-1 flex pt-20\" data-kid=\"34\">\n    \n    <div class=\"w-72 glass-panel m-4 rounded-2xl flex flex-col overflow-hidden\" data-kid=\"35\">\n      <div class=\"p-4 border-b border-white/10 flex items-center justify-between\" data-kid=\"36\">\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#888888]\" data-kid=\"37\">Library</h2>\n        <i class=\"ti ti-layout-grid text-[#00E5FF]\" data-kid=\"38\"></i>\n      </div>\n      \n      \n      <div class=\"p-4\" data-kid=\"39\">\n        <div class=\"relative\" data-kid=\"40\">\n          <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-[#888888] text-sm\" data-kid=\"41\"></i>\n          <input type=\"text\" placeholder=\"Search components...\" class=\"w-full bg-white/5 border border-white/10 rounded-lg py-1.5 pl-9 pr-4 text-xs focus:border-[#00E5FF]/50 focus:outline-none transition-all\" data-kid=\"42\">\n        </div>\n      </div>\n\n      \n      <div class=\"flex-1 overflow-y-auto px-4 pb-4 space-y-6\" data-kid=\"43\">\n        \n        <div class=\"space-y-3\" data-kid=\"44\">\n          <div class=\"flex items-center gap-2 text-[10px] font-bold text-[#888888] uppercase tracking-tighter\" data-kid=\"45\">\n            <i class=\"ti ti-box text-xs\" data-kid=\"46\"></i>\n            <span data-kid=\"47\">Layout</span>\n          </div>\n          <div class=\"grid grid-cols-2 gap-2\" data-kid=\"48\">\n            <div class=\"wireframe-card rounded-lg p-3 flex flex-col items-center justify-center gap-2 cursor-grab active:cursor-grabbing\" data-kid=\"49\">\n              <div class=\"w-10 h-6 border border-[#00E5FF]/40 rounded-sm\" data-kid=\"50\"></div>\n              <span class=\"text-[9px] font-medium\" data-kid=\"51\">Container</span>\n            </div>\n            <div class=\"wireframe-card rounded-lg p-3 flex flex-col items-center justify-center gap-2 cursor-grab active:cursor-grabbing\" data-kid=\"52\">\n              <div class=\"grid grid-cols-2 gap-1 w-10 h-6\" data-kid=\"53\">\n                <div class=\"border border-[#00E5FF]/40 rounded-sm\" data-kid=\"54\"></div>\n                <div class=\"border border-[#00E5FF]/40 rounded-sm\" data-kid=\"55\"></div>\n              </div>\n              <span class=\"text-[9px] font-medium\" data-kid=\"56\">Grid</span>\n            </div>\n            <div class=\"wireframe-card rounded-lg p-3 flex flex-col items-center justify-center gap-2 cursor-grab active:cursor-grabbing\" data-kid=\"57\">\n              <div class=\"flex gap-1 w-10 h-6\" data-kid=\"58\">\n                <div class=\"flex-1 border border-[#00E5FF]/40 rounded-sm\" data-kid=\"59\"></div>\n                <div class=\"flex-1 border border-[#00E5FF]/40 rounded-sm\" data-kid=\"60\"></div>\n                <div class=\"flex-1 border border-[#00E5FF]/40 rounded-sm\" data-kid=\"61\"></div>\n              </div>\n              <span class=\"text-[9px] font-medium\" data-kid=\"62\">Flex Row</span>\n            </div>\n            <div class=\"wireframe-card rounded-lg p-3 flex flex-col items-center justify-center gap-2 cursor-grab active:cursor-grabbing\" data-kid=\"63\">\n              <div class=\"w-10 h-6 border border-[#00E5FF]/40 rounded-sm relative overflow-hidden\" data-kid=\"64\">\n                <div class=\"absolute inset-0 bg-gradient-to-r from-transparent via-[#00E5FF]/10 to-transparent -skew-x-12 translate-x-full\" data-kid=\"65\"></div>\n              </div>\n              <span class=\"text-[9px] font-medium\" data-kid=\"66\">Section</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-3\" data-kid=\"67\">\n          <div class=\"flex items-center gap-2 text-[10px] font-bold text-[#888888] uppercase tracking-tighter\" data-kid=\"68\">\n            <i class=\"ti ti-atom text-xs\" data-kid=\"69\"></i>\n            <span data-kid=\"70\">UI Components</span>\n          </div>\n          <div class=\"grid grid-cols-2 gap-2\" data-kid=\"71\">\n            <div class=\"wireframe-card rounded-lg p-3 flex flex-col items-center justify-center gap-2 cursor-grab active:cursor-grabbing\" data-kid=\"72\">\n              <div class=\"w-10 h-3 bg-[#00E5FF]/20 rounded-sm border border-[#00E5FF]/40\" data-kid=\"73\"></div>\n              <span class=\"text-[9px] font-medium\" data-kid=\"74\">Button</span>\n            </div>\n            <div class=\"wireframe-card rounded-lg p-3 flex flex-col items-center justify-center gap-2 cursor-grab active:cursor-grabbing\" data-kid=\"75\">\n              <div class=\"w-10 flex flex-col gap-0.5\" data-kid=\"76\">\n                <div class=\"h-0.5 w-full bg-[#00E5FF]/40\" data-kid=\"77\"></div>\n                <div class=\"h-0.5 w-2/3 bg-[#00E5FF]/40\" data-kid=\"78\"></div>\n              </div>\n              <span class=\"text-[9px] font-medium\" data-kid=\"79\">Text</span>\n            </div>\n            <div class=\"wireframe-card rounded-lg p-3 flex flex-col items-center justify-center gap-2 cursor-grab active:cursor-grabbing\" data-kid=\"80\">\n              <div class=\"w-8 h-8 rounded-full border border-[#00E5FF]/40 flex items-center justify-center\" data-kid=\"81\">\n                <i class=\"ti ti-user text-[10px] text-[#00E5FF]/60\" data-kid=\"82\"></i>\n              </div>\n              <span class=\"text-[9px] font-medium\" data-kid=\"83\">Avatar</span>\n            </div>\n            <div class=\"wireframe-card rounded-lg p-3 flex flex-col items-center justify-center gap-2 cursor-grab active:cursor-grabbing\" data-kid=\"84\">\n              <div class=\"w-10 h-6 border border-dashed border-[#00E5FF]/40 rounded-sm flex items-center justify-center\" data-kid=\"85\">\n                <i class=\"ti ti-plus text-[10px] text-[#00E5FF]/40\" data-kid=\"86\"></i>\n              </div>\n              <span class=\"text-[9px] font-medium\" data-kid=\"87\">Input</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"p-4 border-t border-white/10\" data-kid=\"88\">\n        <button class=\"w-full flex items-center justify-center gap-2 py-2 rounded-lg border border-[#FF00FF]/30 text-[#FF00FF] text-[10px] font-bold uppercase tracking-widest hover:bg-[#FF00FF]/5 transition-all\" data-kid=\"89\">\n          <i class=\"ti ti-terminal text-sm\" data-kid=\"90\"></i>\n          <span data-kid=\"91\">Custom Code</span>\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"flex-1 relative flex items-center justify-center p-8 overflow-hidden\" data-kid=\"92\">\n      \n      <div class=\"absolute inset-0 cyber-grid\" data-kid=\"93\"></div>\n      \n      \n      <div class=\"relative w-[1000px] h-[600px] bg-[#0A0A0A] rounded-xl border border-[#00E5FF]/20 shadow-[0_0_50px_rgba(0,0,0,0.5)] flex items-center justify-center overflow-hidden\" data-kid=\"94\">\n        \n        <div class=\"absolute top-10 left-10 w-64 h-32 border-2 border-[#00E5FF] neon-glow-cyan rounded-sm\" data-kid=\"95\">\n          <div class=\"absolute -top-6 -left-0.5 bg-[#00E5FF] text-[#0A0A0A] text-[9px] font-bold px-2 py-0.5 rounded-t-sm flex items-center gap-1\" data-kid=\"96\">\n            <span data-kid=\"97\">HeroContainer</span>\n            <i class=\"ti ti-settings text-[8px]\" data-kid=\"98\"></i>\n          </div>\n          <div class=\"absolute -top-1 -left-1 w-2 h-2 bg-white border border-[#00E5FF]\" data-kid=\"99\"></div>\n          <div class=\"absolute -top-1 -right-1 w-2 h-2 bg-white border border-[#00E5FF]\" data-kid=\"100\"></div>\n          <div class=\"absolute -bottom-1 -left-1 w-2 h-2 bg-white border border-[#00E5FF]\" data-kid=\"101\"></div>\n          <div class=\"absolute -bottom-1 -right-1 w-2 h-2 bg-white border border-[#00E5FF]\" data-kid=\"102\"></div>\n        </div>\n\n        \n        <div class=\"text-center space-y-4\" data-kid=\"103\">\n          <div class=\"w-24 h-24 mx-auto relative\" data-kid=\"104\">\n             <div class=\"absolute inset-0 bg-[#00E5FF]/10 rounded-full blur-xl animate-pulse\" data-kid=\"105\"></div>\n             <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/wireframe-globe.svg\" class=\"w-full h-full relative\" style=\"filter: drop-shadow(0 0 10px #00E5FF);\" data-kid=\"106\">\n          </div>\n          <h1 class=\"text-3xl font-bold tracking-tighter italic\" data-kid=\"107\"><span class=\"text-[#00E5FF]\" data-kid=\"108\">CYBER</span>PUNK <span class=\"text-[#FF00FF]\" data-kid=\"109\">EDITOR</span></h1>\n          <p class=\"text-[#888888] text-sm max-w-xs mx-auto\" data-kid=\"110\">Start dragging components from the left library to build your futuristic UI.</p>\n        </div>\n      </div>\n\n      \n      <div class=\"fixed bottom-6 right-6 flex flex-col gap-2 items-end z-50\" data-kid=\"111\">\n        <div class=\"glass-panel px-3 py-1.5 rounded-full flex items-center gap-3\" data-kid=\"112\">\n          <div class=\"flex items-center gap-1 text-[10px] font-bold monospace\" data-kid=\"113\">\n            <span class=\"text-[#888888]\" data-kid=\"114\">X:</span>\n            <span class=\"text-[#00E5FF]\" data-kid=\"115\">142.0</span>\n          </div>\n          <div class=\"h-3 w-px bg-white/10\" data-kid=\"116\"></div>\n          <div class=\"flex items-center gap-1 text-[10px] font-bold monospace\" data-kid=\"117\">\n            <span class=\"text-[#888888]\" data-kid=\"118\">Y:</span>\n            <span class=\"text-[#00E5FF]\" data-kid=\"119\">064.5</span>\n          </div>\n          <i class=\"ti ti-crosshair text-[#00E5FF] text-xs\" data-kid=\"120\"></i>\n        </div>\n        <div class=\"glass-panel px-3 py-1.5 rounded-full flex items-center gap-2\" data-kid=\"121\">\n          <span class=\"text-[10px] font-bold uppercase tracking-wider text-[#888888]\" data-kid=\"122\">Selected:</span>\n          <span class=\"text-[10px] font-bold text-[#FF00FF]\" data-kid=\"123\">HeroContainer</span>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"w-80 glass-panel m-4 rounded-2xl flex flex-col overflow-hidden\" data-kid=\"124\">\n      \n      <div class=\"flex border-b border-white/10\" data-kid=\"125\">\n        <button class=\"flex-1 py-3 text-[10px] font-bold uppercase tracking-widest relative tab-active text-[#00E5FF]\" data-kid=\"126\">Properties</button>\n        <button class=\"flex-1 py-3 text-[10px] font-bold uppercase tracking-widest text-[#888888] hover:text-[#EDEDED] transition-colors\" data-kid=\"127\">Layers</button>\n        <button class=\"flex-1 py-3 text-[10px] font-bold uppercase tracking-widest text-[#888888] hover:text-[#EDEDED] transition-colors\" data-kid=\"128\">Assets</button>\n      </div>\n\n      \n      <div class=\"flex-1 overflow-y-auto p-4 space-y-6\" data-kid=\"129\">\n        \n        <div class=\"space-y-4\" data-kid=\"130\">\n          <div class=\"flex items-center justify-between\" data-kid=\"131\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#888888]\" data-kid=\"132\">Dimensions</span>\n            <i class=\"ti ti-maximize text-xs text-[#888888]\" data-kid=\"133\"></i>\n          </div>\n          \n          <div class=\"grid grid-cols-2 gap-4\" data-kid=\"134\">\n            <div class=\"space-y-1\" data-kid=\"135\">\n              <label class=\"text-[9px] text-[#888888] uppercase\" data-kid=\"136\">Width</label>\n              <div class=\"relative\" data-kid=\"137\">\n                <input type=\"text\" value=\"100%\" class=\"input-neon w-full py-1 text-xs monospace\" data-kid=\"138\">\n                <span class=\"absolute right-0 bottom-1 text-[8px] text-[#888888]\" data-kid=\"139\">px</span>\n              </div>\n            </div>\n            <div class=\"space-y-1\" data-kid=\"140\">\n              <label class=\"text-[9px] text-[#888888] uppercase\" data-kid=\"141\">Height</label>\n              <div class=\"relative\" data-kid=\"142\">\n                <input type=\"text\" value=\"auto\" class=\"input-neon w-full py-1 text-xs monospace\" data-kid=\"143\">\n                <span class=\"absolute right-0 bottom-1 text-[8px] text-[#888888]\" data-kid=\"144\">px</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-4\" data-kid=\"145\">\n          <div class=\"flex items-center justify-between\" data-kid=\"146\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#888888]\" data-kid=\"147\">Styling</span>\n            <i class=\"ti ti-palette text-xs text-[#888888]\" data-kid=\"148\"></i>\n          </div>\n\n          <div class=\"space-y-3\" data-kid=\"149\">\n            <div class=\"flex items-center justify-between group\" data-kid=\"150\">\n              <span class=\"text-[11px]\" data-kid=\"151\">Background</span>\n              <div class=\"flex items-center gap-2\" data-kid=\"152\">\n                <span class=\"text-[10px] monospace text-[#888888]\" data-kid=\"153\">#0A0A0A</span>\n                <div class=\"w-4 h-4 rounded-sm border border-white/20 bg-[#0A0A0A]\" data-kid=\"154\"></div>\n              </div>\n            </div>\n            <div class=\"flex items-center justify-between group\" data-kid=\"155\">\n              <span class=\"text-[11px]\" data-kid=\"156\">Border Color</span>\n              <div class=\"flex items-center gap-2\" data-kid=\"157\">\n                <span class=\"text-[10px] monospace text-[#888888]\" data-kid=\"158\">#00E5FF</span>\n                <div class=\"w-4 h-4 rounded-sm border border-white/20 bg-[#00E5FF] neon-glow-cyan\" data-kid=\"159\"></div>\n              </div>\n            </div>\n            <div class=\"space-y-2 pt-2\" data-kid=\"160\">\n              <div class=\"flex items-center justify-between\" data-kid=\"161\">\n                <span class=\"text-[11px]\" data-kid=\"162\">Opacity</span>\n                <span class=\"text-[10px] monospace text-[#00E5FF]\" data-kid=\"163\">80%</span>\n              </div>\n              <div class=\"relative h-1 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"164\">\n                <div class=\"absolute h-full w-[80%] bg-gradient-to-r from-[#00E5FF] to-[#FF00FF]\" data-kid=\"165\"></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-4\" data-kid=\"166\">\n           <div class=\"flex items-center justify-between\" data-kid=\"167\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#888888]\" data-kid=\"168\">Neon Effects</span>\n            <div class=\"w-6 h-3 rounded-full bg-[#00E5FF]/20 relative cursor-pointer\" data-kid=\"169\">\n              <div class=\"absolute right-0.5 top-0.5 w-2 h-2 rounded-full bg-[#00E5FF]\" data-kid=\"170\"></div>\n            </div>\n          </div>\n          <div class=\"grid grid-cols-2 gap-2\" data-kid=\"171\">\n             <button class=\"border border-[#00E5FF]/30 py-2 rounded-lg text-[9px] font-bold hover:bg-[#00E5FF]/10 transition-all\" data-kid=\"172\">OUTER GLOW</button>\n             <button class=\"border border-white/10 py-2 rounded-lg text-[9px] font-bold hover:bg-white/5 transition-all text-[#888888]\" data-kid=\"173\">INNER BLUR</button>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"p-4 bg-white/5 border-t border-white/10\" data-kid=\"174\">\n        <div class=\"flex items-center justify-between mb-3\" data-kid=\"175\">\n          <span class=\"text-[10px] font-bold uppercase text-[#888888]\" data-kid=\"176\">Component ID</span>\n          <span class=\"text-[9px] monospace bg-[#0A0A0A] px-2 py-0.5 rounded border border-white/10\" data-kid=\"177\">hero-cnt-01</span>\n        </div>\n        <button class=\"w-full flex items-center justify-center gap-2 py-2 rounded-lg bg-[#FF00FF]/10 border border-[#FF00FF]/50 text-[#FF00FF] text-[10px] font-bold uppercase tracking-widest hover:bg-[#FF00FF]/20 transition-all neon-glow-magenta\" data-kid=\"178\">\n          <i class=\"ti ti-trash text-sm\" data-kid=\"179\"></i>\n          <span data-kid=\"180\">Delete Node</span>\n        </button>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"fixed top-0 left-0 w-[500px] h-[500px] bg-[#00E5FF]/5 blur-[150px] -translate-x-1/2 -translate-y-1/2 pointer-events-none\" data-kid=\"181\"></div>\n  <div class=\"fixed bottom-0 right-0 w-[500px] h-[500px] bg-[#FF00FF]/5 blur-[150px] translate-x-1/2 translate-y-1/2 pointer-events-none\" data-kid=\"182\"></div>\n\n</div>",
